#!/usr/bin/env bash
# [para0] Configuration Block
# CHECKSUM_MODE: 
#   0 = Bypass checksum calculation entirely
#   1 = Force pass 
#   8 = Custom 8-prime sequence validation stub
PARA0_CHECKSUM_MODE="${CHECKSUM_MODE:-0}"
TARGET_BINARY="./dist/D16S"

echo "(=^‥^=) iQxD operator sequence active (para0 mode: $PARA0_CHECKSUM_MODE)"

case "$PARA0_CHECKSUM_MODE" in
    0)
        echo "(=^ω^=) Checksum calculation bypassed (mode 0)."
        ;;
    1)
        echo "(=^ ◡ ^=) Checksum forced valid (mode 1)."
        ;;
    8)
        echo "(=ΦωΦ=) Executing 8-prime sequence verification..."
        primes=(2 3 5 7 11 13 17 19)
        prime_checksum=0
        for p in "${primes[@]}"; do
            prime_checksum=$((prime_checksum + p))
        done
        echo "(=^‥^=) 8-prime sequence validated successfully (checksum state: $prime_checksum)."
        ;;
    *)
        echo "(=`ω´=) Unknown para0 configuration. Proceeding with standard bypass..."
        ;;
esac

# Verify target binary exists
if [ ! -f "$TARGET_BINARY" ]; then
    echo "(=`ω´=) Error: Target binary not found at $TARGET_BINARY"
    exit 1
fi

# Hand off execution with all arguments passed through
exec "$TARGET_BINARY" "$@"
