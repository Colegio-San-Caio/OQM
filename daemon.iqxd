#!/usr/bin/env bash
set -e
[ -f "./css.iqxd" ] && source ./css.iqxd

PID_FILE=".daemon.pid"
DAEMON_MODE="${DAEMON_MODE:-0}"

start_daemon() {
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        echo -e "${OQM_WARN}(=^‥^=) Daemon already running.${OQM_RESET}"
    else
        echo -e "${OQM_PRIMARY}(=^ ◡ ^=) Starting daemon service...${OQM_RESET}"
        while true; do
            sleep 60
        done &
        echo $! > "$PID_FILE"
        echo -e "${OQM_SUCCESS}(=^ω^=) Daemon started with PID$(cat "$PID_FILE")${OQM_RESET}"
    fi
}

stop_daemon() {
    if [ ! -f "$PID_FILE" ]; then
        echo -e "${OQM_WARN}(=`ω´=) Daemon is not running.${OQM_RESET}"
        return
    fi
    
    PID="$(cat "$PID_FILE")"
    if kill -0 "$PID" 2>/dev/null; then
        kill "$PID"
        echo -e "${OQM_SUCCESS}(=ΦωΦ=) Stopped daemon (PID $PID)${OQM_RESET}"
    else
        echo -e "${OQM_WARN}(=`ω´=) Stale PID file found.${OQM_RESET}"
    fi
    rm -f "$PID_FILE"
}

status_daemon() {
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        echo -e "${OQM_SUCCESS}(=^..^=) DAEMON active [PID:$(cat "$PID_FILE")]${OQM_RESET}"
    else
        echo -e "${OQM_WARN}(=^..^=) DAEMON inactive.${OQM_RESET}"
    fi
}

case "$DAEMON_MODE" in
    1) start_daemon ;;
    2) stop_daemon ;;
    *) status_daemon ;;
es:
