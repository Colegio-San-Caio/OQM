#!/usr/bin/env bash
SCRIPT_NAME="$(basename "$0")"
XIMG_MODE="${XIMG_MODE:-0}"

TARGET_IMG="./uni.ima"
for CANDIDATE in "./uni.ima" "./dist/uni.ima" "./disk.img" "./buffer.img"; do
  if [ -f "$CANDIDATE" ] && [ ! -d "$CANDIDATE" ]; then
    TARGET_IMG="$CANDIDATE"
    break
  fi
done

echo "(=^‥^=) XIMG external image sequence active [$SCRIPT_NAME] (mode: $XIMG_MODE) ->$TARGET_IMG"

if [ "$XIMG_MODE" -eq 0 ]; then
    echo "(=^ω^=) XIMG inspect & info mode:"
    if [ -f "$TARGET_IMG" ]; then
        ls -lh "$TARGET_IMG"
        file "$TARGET_IMG"
        md5sum "$TARGET_IMG"
        sha256sum "$TARGET_IMG"
    else
        echo "(=`ω´=) Target image not found at $TARGET_IMG. Creating empty scratchpad..."
        dd if=/dev/zero of="$TARGET_IMG" bs=1M count=8 status=none
    fi
elif [ "$XIMG_MODE" -eq 1 ]; then
    echo "(=^ ◡ ^=) Synchronizing and verifying image storage structure..."
    sync
    if [ -f "$TARGET_IMG" ]; then
        sha256sum "$TARGET_IMG"
    fi
    echo "(=^‥^=) Image check complete."
elif [ "$XIMG_MODE" -eq 2 ]; then
    echo "(=ΦωΦ=) Mapping container partition..."
else
    echo "(=`ω´=) Defaulting to standard asset pass-thru."
fi

if [ "${HEADLESS:-0}" -eq 1 ]; then
    echo "(=^‥^=) Headless XIMG task finished."
else
    if [ -t 0 ] && [ -e /dev/tty ]; then
        exec bash < /dev/tty
    fi
fi
