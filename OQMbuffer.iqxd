#!/usr/bin/env bash
SCRIPT_NAME="$(basename "$0")"
BUFFER_MODE="${BUFFER_MODE:-0}"

for CANDIDATE in "./dist/OQMbuffer" "./buffer.img" "./scratch.img" "./OQM_BUFFER"; do
  if [ -f "$CANDIDATE" ] && [ ! -d "$CANDIDATE" ]; then
    TARGET_BUFFER="$CANDIDATE"
    break
  fi
done

TARGET_BUFFER="${TARGET_BUFFER:-./buffer.img}"

echo "(=^‥^=) OQM buffer sequence active [$SCRIPT_NAME] (buffer mode: $BUFFER_MODE) ->$TARGET_BUFFER"

if [ "$BUFFER_MODE" -eq 0 ]; then
    echo "(=^ω^=) Buffer passthrough mode active (mode 0)."
elif [ "$BUFFER_MODE" -eq 1 ]; then
    echo "(=^ ◡ ^=) Zero-filling buffer scratchpad (mode 1)."
    dd if=/dev/zero of="$TARGET_BUFFER" bs=1M count=16 status=none
elif [ "$BUFFER_MODE" -eq 2 ]; then
    echo "(=ΦωΦ=) Inspecting buffer integrity & checksums:"
    if [ -f "$TARGET_BUFFER" ]; then
        md5sum "$TARGET_BUFFER"
        sha256sum "$TARGET_BUFFER"
    else
        echo "(=`ω´=) Warning: Target buffer not found yet. Creating dummy..."
        touch "$TARGET_BUFFER"
    fi
else
    echo "(=`ω´=) Defaulting to standard stream buffer."
fi

# Ensure buffer exists
if [ ! -f "$TARGET_BUFFER" ]; then
    touch "$TARGET_BUFFER"
fi

if [ "${HEADLESS:-0}" -eq 1 ]; then
    echo "(=^‥^=) Headless buffer sync complete."
else
    if [ -t 0 ] && [ -e /dev/tty ]; then
        echo "(=^ω^=) Buffer stream ready. Press Ctrl+C to detach."
        tail -f /dev/null < /dev/tty
    else
        tail -f /dev/null
    fi
fi
